# HRestroSewa — environment template.
#
# Copy to `.env.local` for local/internal testing (pointed at the DEV Supabase
# project), and keep production values OUT of the repo — every real `.env*` file
# is gitignored. Nothing here is secret; replace each placeholder.
#
# Which file Next.js loads:
#   npm run dev                  → .env.local
#   npm run build && npm start   → .env.production, BUT .env.local still WINS if
#                                  it exists. So a production build run on this
#                                  machine talks to the DEV project. That is the
#                                  safe default; to test against production
#                                  locally you must temporarily move .env.local
#                                  aside. On a host (Vercel etc.) these files are
#                                  not used at all — set the vars in its dashboard.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key — safe to expose to the browser>

# Project Settings → API. NEVER goes in the browser and never in git: it bypasses
# RLS completely, so it can read and write every restaurant's data.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Project Settings → Database → Connection string → **Session pooler**.
# Use the POOLER host (aws-N-<region>.pooler.supabase.com), not the direct
# `db.<ref>.supabase.co` host — the direct one is IPv6-only on most networks and
# will fail with ENETUNREACH or a timeout.
# Used by the realtime bus (lib/realtime/bus.ts) and by the migration/test
# tooling, so a wrong value breaks live updates in the app, not just scripts.
# ALWAYS QUOTE IT: an unquoted value containing `#` is truncated there by dotenv.
# Hosted Supabase requires TLS, which is the default. A SELF-HOSTED Postgres
# container normally runs with `ssl = off`, and connecting with TLS anyway throws
# "The server does not support SSL connections" — append `?sslmode=disable` for
# those. Nothing else is read from the query string.
SUPABASE_DB_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ── Web push (PWA notifications) ──────────────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# The pair must MATCH the subscriptions stored in the database — regenerating
# them invalidates every existing device subscription, so a dev project should
# have its own pair rather than borrowing production's.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid public key>
VAPID_PRIVATE_KEY=<vapid private key>
VAPID_SUBJECT=mailto:you@example.com
# ── Outgoing report email ─────────────────────────────────────────────────────
# TWO transports; whichever credential is present wins, Resend first.
#
# RESEND (HTTPS, port 443) — required on DigitalOcean. That network silently
# DROPS outbound packets on every SMTP port (25/465/587) to every provider, so
# nodemailer cannot deliver from the droplet at all. Port 443 is open.
#   MAIL_FROM must be on a domain verified in the Resend dashboard; a gmail.com
#   sender is rejected, so GMAIL_USER is not a usable fallback here.
RESEND_API_KEY=<re_... from resend.com/api-keys>
MAIL_FROM=reports@<your-verified-domain>

# GMAIL SMTP — the original transport. Still correct anywhere SMTP is not
# blocked (a local machine, Vercel). Used only when RESEND_API_KEY is unset.
# The password is a Google APP PASSWORD, never the account password.
GMAIL_USER=<sender@gmail.com>
GMAIL_APP_PASSWORD=<16-char app password>

# Display name on the From: header, shared by both transports.
SUMMARY_FROM_NAME=HRestroSewa Reports

# Shared secret for /api/cron/daily-summary. The scheduler sends it as
# `x-cron-secret`; the route rejects anything else.
CRON_SECRET=<64 random hex chars>

# Hard floor for UNATTENDED report sending, YYYY-MM-DD (optional).
# The scheduler never auto-sends a business day earlier than this. Use it after
# an outage so a restored transport does not dump the whole backlog on owners in
# one tick. The admin "Retry" button ignores it, so a specific day can still be
# sent deliberately. Independent of the built-in 2-day staleness guard.
REPORT_SEND_FROM=
